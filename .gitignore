# ── Model weights & tokenizer (not tracked — download via HuggingFace) ────────
models/
# Exception: keep small config/metadata files that describe the adapter
!models/nl2sql/
!models/nl2sql/adapter_config.json
!models/nl2sql/chat_template.jinja
!models/nl2sql/run_metadata.json
!models/nl2sql/eval_results.json
# Explicitly exclude all binary weights and large tokenizer vocab
models/nl2sql/adapter_model.safetensors
models/nl2sql/tokenizer.json
models/nl2sql/tokenizer_config.json


# ── .env.example ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is never committed to git (see .gitignore).
#
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Required to download gated models (Llama-3.2-3B-Instruct).
# Get yours at: https://huggingface.co/settings/tokens
# Accept the Llama licence first: https://huggingface.co/meta-llama/Llama-3.2-3B-Instruct
HF_TOKEN=hf_your_token_here

# ── OpenAI (optional) ─────────────────────────────────────────────────────────
# Only needed if you want to use GPT-4 for fluency scoring in eval_benchmark.py
# or to distill the NL2SQL training dataset via OpenAI.
# Leave blank to skip those features.
OPENAI_API_KEY=sk-your_key_here

# ── vLLM server ───────────────────────────────────────────────────────────────
# Override these if you run the server on a non-default host/port.
VLLM_HOST=localhost
VLLM_PORT=8001

# ── Data paths (optional overrides) ───────────────────────────────────────────
# All paths default to relative paths inside the project root.
# Override here if your filings live elsewhere.
# FILINGS_DIR=data/filings
# DB_PATH=data/financials.db
# VECTORDB_DIR=data/vectordb
